PORT=8000
WEB_CONCURRENCY=2

# Pflicht in Produktion. Wird sonst beim ersten Start zufaellig generiert
# und unter data/.secret_key abgelegt. Setze diesen Wert hier explizit, dann
# kann die Datei geloescht werden.
# Generierung: openssl rand -base64 64
#SECRET_KEY=

# Cookie nur ueber HTTPS senden. Aktiviere wenn der Server hinter TLS laeuft.
#SESSION_COOKIE_SECURE=true

# Lebensdauer der Session in Sekunden, default 14 Tage.
#SESSION_LIFETIME_SECONDS=1209600

# SameSite-Policy fuer den Session-Cookie. Standard Lax reicht meistens.
#SESSION_COOKIE_SAMESITE=Lax

# Anzahl der Reverse-Proxy-Hops vor Flask. 1 fuer Nginx/Caddy direkt davor.
# Auf 0 setzen wenn Flask direkt erreichbar ist.
#PROXY_HOPS=1

# Optional: zentrales Datenverzeichnis. Default ist data/ neben der App.
#DATA_DIR=/var/lib/central-upstream/data

# Optional: SQLite-Pfade. Standardpfade liegen unter DATA_DIR.
#HEALTH_DB_PATH=
#HEALTH_DB_SCHEMA_PATH=
